# ============================================
# Telnyx API Configuration
# ============================================
TELNYX_API_KEY=your_telnyx_api_key_here
TELNYX_API_URL=https://api.telnyx.com/v2

# Your Telnyx Phone Number (the number you purchased)
TELNYX_PHONE_NUMBER=+1234567890

# Connection ID (from your Telnyx account)
TELNYX_CONNECTION_ID=your_connection_id_here

# ============================================
# Server Configuration
# ============================================
NODE_ENV=development
PORT=3000
HOST=localhost

# ============================================
# Webhook Configuration
# ============================================
WEBHOOK_URL=http://localhost:3000/webhooks
WEBHOOK_PORT=3000
WEBHOOK_PATH=/webhooks

# ============================================
# WebSocket Configuration (Media Streaming)
# ============================================
WEBSOCKET_SERVER_URL=ws://localhost:3000/media
WEBSOCKET_PORT=3000

# ============================================
# Media Streaming Configuration
# ============================================
STREAM_TRACK=both_tracks
STREAM_BIDIRECTIONAL_MODE=rtp
STREAM_BIDIRECTIONAL_CODEC=PCMU

# ============================================
# Call Configuration (for testing)
# ============================================
TEST_PHONE_NUMBER=+18005551234
TEST_CALL_TIMEOUT=300

# ============================================
# Logging Configuration
# ============================================
LOG_LEVEL=info
BIDIRECTIONAL_MODE=rtp
STREAM_CODEC=PCMU

# Environment
NODE_ENV=development
