# Telnyx API Key
TELNYX_API_KEY=your_telnyx_api_key_here

# Your Telnyx Phone Number (the number you purchased)
TELNYX_PHONE_NUMBER=+1234567890

# Connection ID (from your Telnyx account)
TELNYX_CONNECTION_ID=your_connection_id_here

# Webhook Configuration
WEBHOOK_URL=https://yourdomain.ngrok.io/webhooks
LOCAL_PORT=3000
WEBHOOK_PORT=3001

# WebSocket Configuration
WEBSOCKET_SERVER_URL=wss://yourdomain.ngrok.io/media

# Call Configuration (for testing)
TEST_PHONE_NUMBER=+18005551234
STREAM_TRACK=both_tracks
BIDIRECTIONAL_MODE=rtp
STREAM_CODEC=PCMU

# Environment
NODE_ENV=development
